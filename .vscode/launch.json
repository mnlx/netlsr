{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C - main.c",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/labs/crewrite/main",
            "args": ["google.com"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/labs/crewrite",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-c-main"
        },
        {
            "name": "Debug C - General",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-c"
        },
        {
            "name": "Run Go Sudo",
            "asRoot": true,
            // "buildFlags": ["-tags=linux"],
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "args": ["-mode", "client", "-ifname", "utun99", "-local-ip", "10.99.0.1/16", "-peer-ip", "10.99.0.2", "-remote", "10.100.0.128", "-port", "5000"],
            "console": "integratedTerminal"
        },
        {
            "name": "Run Go",
            // "buildFlags": ["-tags=linux"],
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            // "args": ["-mode", "client", "-ifname", "utun99", "-local-ip", "10.99.0.1/16", "-peer-ip", "10.99.0.2", "-remote", "10.100.0.128", "-port", "5000"],
            "console": "integratedTerminal"
        }
    ]
}